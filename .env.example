# Copy this file to .env (in the repo root or in code/) and fill in your values. Never commit .env.

# Free API key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# VISION_MODEL=qwen/qwen3.8-27b
# TRANSCRIBE_MODEL=whisper-large-v3

# Router agent (defaults shown); the fallback takes over when the first model's quota is spent
# ROUTER_MODEL=openai/gpt-oss-120b
# ROUTER_FALLBACK_MODEL=openai/gpt-oss-20b
# ROUTER_REASONING_EFFORT=low

# Optional: adds a prompt-injection score to safety_scan (off when unset)
# PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
